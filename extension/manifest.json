{
  "manifest_version": 3,
  "name": "Travian Bot",
  "version": "5.11.1",
  "description": "TO DO LIST por aldea (tropas, obras, hospital, fiestas) sin cargar páginas, farm list por la API, tropas, héroe y construcción.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.travian.com/*",
    "*://*.travian.net/*",
    "*://*.travian.de/*",
    "*://*.travian.com.br/*",
    "*://*.travian.ru/*",
    "*://*.travian.es/*",
    "*://*.travian.it/*",
    "*://*.travian.fr/*",
    "*://*.travian.pl/*",
    "*://*.travian.pt/*",
    "*://*.travian.com.tr/*",
    "*://*.travian.cz/*",
    "*://*.travian.hu/*",
    "*://*.travian.ro/*",
    "*://*.travian.gr/*",
    "*://*.travian.nl/*",
    "*://*.travian.se/*",
    "*://*.travian.dk/*",
    "*://*.travian.fi/*",
    "*://*.travian.no/*",
    "*://*.travian.ae/*",
    "*://*.travian.asia/*",
    "*://*.travian.co.id/*",
    "*://*.travian.co.kr/*",
    "*://*.travian.jp/*",
    "*://*.travian.cn/*",
    "*://*.travian.in/*",
    "*://*.travian.ir/*",
    "*://*.travian.us/*",
    "*://*.travian.co.uk/*",
    "*://*.travian.ua/*",
    "*://*.travian.sk/*",
    "*://*.travian.si/*",
    "*://*.travian.hr/*",
    "*://*.travian.rs/*",
    "*://*.travian.bg/*",
    "*://*.travian.lt/*",
    "*://*.travian.lv/*",
    "*://*.travian.ee/*",
    "*://*.travian.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.travian.com/*",
        "*://*.travian.net/*",
        "*://*.travian.de/*",
        "*://*.travian.com.br/*",
        "*://*.travian.ru/*",
        "*://*.travian.es/*",
        "*://*.travian.it/*",
        "*://*.travian.fr/*",
        "*://*.travian.pl/*",
        "*://*.travian.pt/*",
        "*://*.travian.com.tr/*",
        "*://*.travian.cz/*",
        "*://*.travian.hu/*",
        "*://*.travian.ro/*",
        "*://*.travian.gr/*",
        "*://*.travian.nl/*",
        "*://*.travian.se/*",
        "*://*.travian.dk/*",
        "*://*.travian.fi/*",
        "*://*.travian.no/*",
        "*://*.travian.ae/*",
        "*://*.travian.asia/*",
        "*://*.travian.co.id/*",
        "*://*.travian.co.kr/*",
        "*://*.travian.jp/*",
        "*://*.travian.cn/*",
        "*://*.travian.in/*",
        "*://*.travian.ir/*",
        "*://*.travian.us/*",
        "*://*.travian.co.uk/*",
        "*://*.travian.ua/*",
        "*://*.travian.sk/*",
        "*://*.travian.si/*",
        "*://*.travian.hr/*",
        "*://*.travian.rs/*",
        "*://*.travian.bg/*",
        "*://*.travian.lt/*",
        "*://*.travian.lv/*",
        "*://*.travian.ee/*",
        "*://*.travian.org/*"
      ],
      "js": [
        "lista.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "panel.html",
    "default_title": "Travian Bot"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
